<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A data persistence abstraction layer for Cosmos DB</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Cosmos.Repository</AssemblyName>
        <PackageId>Soenneker.Cosmos.Repository</PackageId>
        <PackageTags>cosmos db repository c# .net dotnet</PackageTags>
        <Copyright>Copyright © 2023-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.cosmos.repository</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.cosmos.repository</RepositoryUrl>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.ConcurrentProcessing.Executor" Version="11.0.380" />
        <PackageReference Include="Soenneker.Constants.Data" Version="11.0.663" />
        <PackageReference Include="Soenneker.Cosmos.Container" Version="11.0.2617" />
        <PackageReference Include="Soenneker.Cosmos.Linq" Version="11.0.25" />
        <PackageReference Include="Soenneker.Cosmos.RequestOptions" Version="11.0.198" />
        <PackageReference Include="Soenneker.Documents.Audit" Version="11.0.2648" />
        <PackageReference Include="Soenneker.Dtos.IdNamePair" Version="11.0.746" />
        <PackageReference Include="Soenneker.Dtos.IdPartitionPair" Version="11.0.753" />
        <PackageReference Include="Soenneker.Utils.BackgroundQueue" Version="11.0.2547" />
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2769" />
        <PackageReference Include="Soenneker.Utils.Method" Version="11.0.475" />
        <PackageReference Include="Soenneker.Utils.UserContext" Version="11.0.1850" />
    </ItemGroup>
</Project>
